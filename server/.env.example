# Example environment variables for local development

PAYPAL_CLIENT_ID=YOUR_PAYPAL_CLIENT_ID_HERE
PAYPAL_SECRET=YOUR_PAYPAL_SECRET_HERE
PAYPAL_MODE=sandbox

# Optional: paste the entire Firebase service account JSON as a single-line string
# (or use application default credentials when deploying to Google Cloud / Firebase)
FIREBASE_SERVICE_ACCOUNT_JSON={...}
