{
  "ci": {
    "collect": {
      "url": [
        "http://127.0.0.1:9001/index.html"
      ],
      "numberOfRuns": 1,
      "settings": {
        "chromeFlags": "--headless --no-sandbox --disable-dev-shm-usage"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "warn",
          {
            "minScore": 0.45
          }
        ],
        "categories:accessibility": [
          "warn",
          {
            "minScore": 0.75
          }
        ],
        "categories:best-practices": [
          "warn",
          {
            "minScore": 0.75
          }
        ],
        "categories:seo": [
          "warn",
          {
            "minScore": 0.75
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./lhci_reports"
    }
  }
}
